default_platform(:ios)

APP_ID   = "com.learnthroughstories.chessboxing"
TEAM_ID  = "4L856PWBZN"
# DURABLE keychain path. Do NOT move this back under /tmp: macOS periodically
# cleans /tmp, which silently destroys the signing private key while Apple
# still counts the certificate against the account cap. That is exactly how
# all 3 distribution certs were lost and had to be revoked (2026-08-27).
KC_PATH  = File.expand_path("~/Library/Keychains/chessbox-signing.keychain-db")
KC_PASS  = "chessbox"

platform :ios do
  desc "Create app record, cert, profile, archive, upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      key_filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8"),
      in_house: false
    )

    # 1. Ensure bundle ID + app record exist (via App Store Connect API, no 2FA)
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token

    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if bundle.nil?
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "Chess Boxing", identifier: APP_ID, platform: "IOS")
      UI.success("Registered bundle ID #{APP_ID}")
    else
      UI.message("Bundle ID already registered")
    end

    if Spaceship::ConnectAPI::App.find(APP_ID).nil?
      UI.important("No App Store Connect app record yet — Apple blocks creating it via API. Create it in the browser; build continues.")
    else
      UI.message("App record already exists")
    end

    # 2. Distribution certificate into a dedicated unlocked keychain
    cert(
      api_key: api_key,
      keychain_path: KC_PATH,
      keychain_password: KC_PASS,
      output_path: "/tmp/chessbox_certs"
    )

    # 3. App Store provisioning profile (no device required)
    profile_name = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      readonly: false,
      output_path: "/tmp/chessbox_certs"
    )

    # 4. Manual signing on the project
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_ID,
      profile_name: lane_context[SharedValues::SIGH_NAME],
      targets: ["App"]
    )

    # 5. Archive + export a signed App Store IPA
    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "/tmp/chessbox_build",
      output_name: "ChessBoxing.ipa",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => lane_context[SharedValues::SIGH_NAME] }
      }
    )

    UI.success("Signed IPA ready at /tmp/chessbox_build/ChessBoxing.ipa")
  end

  desc "Upload the built IPA to TestFlight"
  lane :upload do
    api_key = app_store_connect_api_key(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      key_filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8"),
      in_house: false
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: "/tmp/chessbox_build/ChessBoxing.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end

platform :ios do
  desc "Show latest TestFlight build processing status"
  lane :status do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 3)
    UI.important("no builds found") if builds.empty?
    builds.each { |b| UI.success("v#{b.version} state=#{b.processing_state} uploaded=#{b.uploaded_date}") }
  end
end

platform :ios do
  desc "Distribute latest build to internal testers"
  lane :invite do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    groups = app.get_beta_groups
    groups.each { |g| UI.message("group: #{g.name} internal=#{g.is_internal_group}") }
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 1).first
    internal = groups.find { |g| g.is_internal_group }
    if internal.nil?
      tf = Spaceship::ConnectAPI::TestFlight::Client.new(token: token)
      body = { data: { attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true },
                       relationships: { app: { data: { id: app.id, type: "apps" } } },
                       type: "betaGroups" } }
      resp = tf.post("v1/betaGroups", body)
      internal = resp.to_models.first
      UI.success("created internal group")
    end
    build.add_beta_groups(beta_groups: [internal]) rescue UI.message("build already in group or auto-included")
    UI.success("Internal group '#{internal.name}' wired to build v#{build.version}")
  end
end

platform :ios do
  desc "Add Tyler as internal tester"
  lane :add_tester do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    internal = app.get_beta_groups.find { |g| g.is_internal_group }
    begin
      Spaceship::ConnectAPI.post_beta_tester_assignment(beta_group_ids: [internal.id], attributes: { email: "tyler@tylervsnyc.com", firstName: "Tyler", lastName: "Schwartz" })
    rescue => e
      UI.message("assign skipped: #{e.message.lines.first}")
    end
    resp = Spaceship::ConnectAPI.get_beta_testers(filter: { betaGroups: internal.id })
    UI.success("assignment posted; group testers now: #{resp.to_models.map { |t| "#{t.email}" }.join(', ')}")
  end
end

platform :ios do
  desc "Debug build distribution state"
  lane :debug_dist do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 1).first
    UI.important("build v#{build.version} processing=#{build.processing_state} nonExemptEncryption=#{build.uses_non_exempt_encryption.inspect} expired=#{build.expired}")
    tf = Spaceship::ConnectAPI::TestFlight::Client.new(token: token)
    resp = tf.get("v1/builds/#{build.id}/betaGroups")
    UI.important("groups on build: #{resp.to_models.map(&:name).join(', ')}")
    inv = tf.get("v1/betaTesters", { filter: { apps: app.id } })
    inv.to_models.each { |t| UI.important("tester #{t.email}") }
  end

  desc "Attach the latest processed build to every beta group"
  lane :dist_latest do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 1).first
    UI.important("attaching build v#{build.version} (#{build.processing_state}) to groups")
    tf = Spaceship::ConnectAPI::TestFlight::Client.new(token: token)
    groups = tf.get("v1/apps/#{app.id}/betaGroups").to_models
    groups.each do |g|
      if g.is_internal_group
        UI.important("skipping internal group '#{g.name}' (gets builds automatically)")
        next
      end
      tf.post("v1/betaGroups/#{g.id}/relationships/builds",
              { data: [{ id: build.id, type: "builds" }] })
      UI.success("added v#{build.version} to group '#{g.name}'")
    end
  end
end

platform :ios do
  desc "Set export compliance on latest build"
  lane :fix_compliance do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 1).first
    tf = Spaceship::ConnectAPI::TestFlight::Client.new(token: token)
    body = { data: { id: build.id, type: "builds", attributes: { usesNonExemptEncryption: false } } }
    tf.patch("v1/builds/#{build.id}", body)
    fresh = Spaceship::ConnectAPI::Build.get(build_id: build.id)
    UI.success("build v#{fresh.version} nonExemptEncryption=#{fresh.uses_non_exempt_encryption.inspect}")
  end
end

platform :ios do
  desc "List App Store versions + attached builds"
  lane :versions do
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    app.get_app_store_versions(includes: "build").each do |v|
      b = v.build
      UI.message("VERSION #{v.version_string} state=#{v.app_store_state} build=#{b ? b.version : 'none'} id=#{v.id}")
    end
  end
end

platform :ios do
  desc "Create/attach an App Store version for the latest build and submit for review. VERSION=1.0.2 BUILD=8"
  lane :release do
    ver = ENV.fetch("VERSION")
    build_no = ENV.fetch("BUILD")
    whats_new = ENV.fetch("WHATS_NEW")
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "767R5DY9P3",
      issuer_id: "ec78424a-d56e-4da4-ace6-cc4e91f8bb49",
      filepath: File.expand_path("~/Downloads/AuthKey_767R5DY9P3.p8")
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find(APP_ID)

    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 10).find { |b| b.version == build_no }
    UI.user_error!("build #{build_no} not found") unless build
    UI.message("build #{build.version} state=#{build.processing_state}")
    if build.uses_non_exempt_encryption.nil?
      tf = Spaceship::ConnectAPI::TestFlight::Client.new(token: token)
      tf.patch("v1/builds/#{build.id}", { data: { id: build.id, type: "builds", attributes: { usesNonExemptEncryption: false } } })
      UI.success("set export compliance on build #{build_no}")
    end

    version = app.get_app_store_versions(filter: { versionString: ver }).first
    if version
      UI.message("version #{ver} exists state=#{version.app_store_state}")
    else
      version = Spaceship::ConnectAPI.post_app_store_version(app_id: app.id, attributes: { platform: "IOS", versionString: ver, releaseType: "AFTER_APPROVAL" }).first
      UI.success("created version #{ver}")
    end

    loc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    if loc
      loc.update(attributes: { whatsNew: whats_new })
    else
      Spaceship::ConnectAPI.post_app_store_version_localization(app_store_version_id: version.id, attributes: { locale: "en-US", whatsNew: whats_new })
    end
    UI.success("What's New set")

    version.select_build(build_id: build.id)
    UI.success("attached build #{build_no} to #{ver}")

    submission = app.get_ready_review_submission(platform: "IOS", includes: "items") || app.create_review_submission(platform: "IOS")
    submission.add_app_store_version_to_review_items(app_store_version_id: version.id)
    submission.submit_for_review
    fresh = app.get_app_store_versions(filter: { versionString: ver }).first
    UI.success("SUBMITTED #{ver} (build #{build_no}) — state=#{fresh.app_store_state}")
  end
end
