# Copy to .env.local (gitignored). Everything here is optional — the game is
# fully playable with none of it set.

# Analytics. 12 run_* events fire from app/page.tsx.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Shared with The Chess Path — same project, same values.
# Note run.chesspath.app is a different origin from chesspath.app, so auth
# sessions are NOT shared between the two apps.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/run-trace to write playtest traces in production,
# and by scripts/run-playtest/pull-traces.ts to read them back.
SUPABASE_SERVICE_ROLE_KEY=
