# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs
# Create a product "The Chess Path Premium" in Stripe Dashboard
# Then add these two prices and copy the IDs here
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_your_yearly_price_id

# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App URL (for redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (CHE-345 / Engine 2 — Retain) — re-engagement notifications.
# Generate a VAPID keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Put the SAME public key in BOTH NEXT_PUBLIC_VAPID_PUBLIC_KEY (client) and
# VAPID_PUBLIC_KEY (server). Keep VAPID_PRIVATE_KEY secret — never commit it.
# WEB_PUSH_ENABLED gates ALL sending. Leave "false" until ready to go live;
# when false the send helper dry-runs (logs only) and sends NOTHING.
WEB_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:you@example.com
